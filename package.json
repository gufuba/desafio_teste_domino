{
  "name": "desafio_teste_domino",
  "version": "1.0.0",
  "description": "Casos de teste em JavaScript (Jest) para uma partida de Domino para 2 jogadores",
  "main": "src/domino.js",
  "scripts": {
    "test": "jest --coverage"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
